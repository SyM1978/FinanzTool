# In Dokploy: Projekt › Compose-Dienst › Environment einfügen und Werte ersetzen.
# Lokal: als .env neben docker-compose.yml speichern.
# Passwörter am besten nur aus Buchstaben und Ziffern (z. B. openssl rand -hex 24).

POSTGRES_PASSWORD=bitte-ersetzen-superuser
APP_DB_PASSWORD=bitte-ersetzen-app

# Neue Konten: open = jeder kann sich registrieren, invite = nur mit Code, closed = niemand mehr
REGISTRATION=open
# nur bei REGISTRATION=invite nötig (und für das allererste Konto, falls gesetzt)
INVITE_CODE=
# E-Mail-Bestätigung: auto = Pflicht, sobald SMTP eingetragen ist · 1 = immer · 0 = nie
VERIFY_EMAIL=auto

APP_URL=https://finanzen.deine-domain.de
TZ=Europe/Berlin

# Mailversand: Bestätigungslinks, „Passwort vergessen“ und Kursalarme.
# Ohne SMTP funktioniert die App, aber ohne diese drei Funktionen.
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
