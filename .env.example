# In Dokploy: Projekt › Compose-Dienst › Environment einfügen und Werte ersetzen.
# Lokal: als .env neben docker-compose.yml speichern.
# Passwörter am besten nur aus Buchstaben und Ziffern (z. B. openssl rand -hex 24).

POSTGRES_PASSWORD=bitte-ersetzen-superuser
APP_DB_PASSWORD=bitte-ersetzen-app

# Neue Konten: invite = nur mit Code, open = jeder, closed = niemand mehr
REGISTRATION=invite
INVITE_CODE=bitte-ersetzen-einladung

APP_URL=https://finanzen.deine-domain.de
TZ=Europe/Berlin

# Mailversand für Kursalarme (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
