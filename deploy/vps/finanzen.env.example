# /etc/finanzen/finanzen.env  – Rechte: chmod 640, Gruppe finanzen
# Datenbank: immer die App-Rolle, nie postgres
DATABASE_URL=postgresql://finanzen_app:HIER_DAS_DB_PASSWORT@localhost/finanzen

# Neue Konten: invite = nur mit Einladungscode, open = jeder, closed = keine weiteren
REGISTRATION=invite
INVITE_CODE=HIER_EIN_EINLADUNGSCODE
# Mindestlänge Passwort
MIN_PASSWORD=10
SESSION_DAYS=30
COOKIE_SECURE=1

# Link in den Alarm-Mails
APP_URL=https://finanzen.example.de

# Mailversand für Kursalarme (z. B. Postfach beim Webhoster)
SMTP_HOST=smtp.example.de
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_USER=finanzen@example.de
SMTP_PASSWORD=
MAIL_FROM=finanzen@example.de

WEB_DIR=/opt/finanzen/web
