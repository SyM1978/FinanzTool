[Unit]
Description=Meine Finanzen – Kursalarme per E-Mail prüfen
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=finanzen
Group=finanzen
WorkingDirectory=/opt/finanzen/server
EnvironmentFile=/etc/finanzen/finanzen.env
ExecStart=/opt/finanzen/venv/bin/python -m finanzen.alerts run
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
